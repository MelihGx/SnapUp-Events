# PATCH 8B preparation only. Not a runnable environment; do not load as backend/.env.
# Never fill secrets in this tracked template. Use provider secret fields.
# Missing identities and pins intentionally keep PATCH 8A fail-closed.
APP_ENV=staging
NODE_ENV=production
# Candidate from official Node 22 archive, not locally tested here:
NODE_VERSION=22.23.4
# Render supplies RENDER_SERVICE_ID and PORT; do not spoof or override them.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_JURISDICTION=
R2_ORIGINAL_BUCKET=
R2_DISPLAY_BUCKET=
R2_DISPLAY_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
JWT_SECRET=
GUEST_JWT_SECRET=
JWT_EXPIRES_IN=15m
FRONTEND_URL=
CORS_ORIGINS=

# Conservative initial smoke candidate only, not approved production capacity.
UPLOAD_MAX_ACTIVE=1
VIDEO_QUEUE_POLL_MS=3000
# Resolve and verify both tools in the selected Render runtime before start.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Real registration/mail tests require an approved separate test mailbox/provider.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_LOGO_URL=
# Turnstile must be configured explicitly; false is only an initial smoke choice.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# Required only for separately approved legacy Cloudinary flows.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AUTH_TOKEN_KEY=
# Does not authorize cleanup or --apply.
R2_RECONCILE_MIN_AGE_HOURS=24
