# Cloudflare R2 — SnapUp Events image storage
# Do NOT commit real secrets.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Private bucket. Do NOT enable r2.dev or a public custom domain.
R2_ORIGINAL_BUCKET=snapup-originals

# Public optimized-image bucket.
R2_DISPLAY_BUCKET=snapup-display

# Production custom domain attached to R2_DISPLAY_BUCKET.
# Example:
R2_DISPLAY_PUBLIC_BASE_URL=https://media.snapupevents.com

# Optional tuning:
R2_IMAGE_DISPLAY_MAX_DIMENSION=2560
R2_IMAGE_DISPLAY_WEBP_QUALITY=86
R2_ORIGINAL_DOWNLOAD_TTL_SECONDS=900

# Optional. Leave blank for standard R2 endpoint.
# Use only if your bucket/account uses a jurisdiction-specific endpoint.
R2_S3_ENDPOINT=
# Alternative shorthand if applicable: eu or us
R2_JURISDICTION=
